<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_active_company" model="ir.ui.view">
        <field name="name">product.template.form.active.company</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="readonly">not id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
